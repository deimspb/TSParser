<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TSParser.Desktop.ViewModels"
        xmlns:controls="using:TSParser.Desktop.Controls"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DesignWidth="1200"
        d:DesignHeight="800"
        x:Class="TSParser.Desktop.Views.MainWindow"
        x:DataType="vm:MainWindowViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Title="{Binding WindowTitle}"
        Width="1200"
        Height="800"
        MinWidth="900"
        MinHeight="600">

    <Design.DataContext>
        <vm:MainWindowViewModel/>
    </Design.DataContext>

    <Grid RowDefinitions="Auto,*">
        <controls:ParserToolbarControl x:Name="ParserToolbar" Grid.Row="0" DataContext="{Binding}"/>

        <Panel Grid.Row="1">
            <Border IsVisible="{Binding !HasSource}" Background="#f8fafc" Padding="40">
                <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center" MaxWidth="560" Spacing="14">
                    <Border Width="72" Height="72" CornerRadius="36" Background="#e7f0ff" HorizontalAlignment="Center">
                        <TextBlock Text="TS" Foreground="#0d6efd" FontSize="24" FontWeight="Bold"
                                   HorizontalAlignment="Center" VerticalAlignment="Center"/>
                    </Border>
                    <TextBlock Text="Start transport stream analysis" FontSize="26" FontWeight="SemiBold"
                               TextAlignment="Center"/>
                    <TextBlock Text="Open a recorded transport stream or connect to a multicast source. Tables, services, bitrate and compliance errors will appear as packets arrive."
                               Foreground="#5f6b76" FontSize="14" TextWrapping="Wrap" TextAlignment="Center"/>
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" Spacing="10" Margin="0,8,0,0">
                        <Button Classes="launch-btn-primary" Content="Open TS file" Click="OnEmptyOpenFileClick"/>
                        <Button Classes="launch-btn" Content="Connect UDP" Click="OnEmptyConnectUdpClick"/>
                    </StackPanel>
                </StackPanel>
            </Border>

            <TabControl IsVisible="{Binding HasSource}" Classes="parser-tabs" Margin="0,4,0,0">
                <TabItem Header="Overview">
                    <ScrollViewer>
                        <StackPanel Margin="24" Spacing="18">
                            <StackPanel>
                                <TextBlock Text="Stream overview" FontSize="22" FontWeight="SemiBold"/>
                                <TextBlock Text="{Binding SourceSummary}" Foreground="#6c757d" Margin="0,3,0,0"/>
                            </StackPanel>
                            <UniformGrid Columns="3" Rows="2">
                                <Border Classes="summary-card"><StackPanel><TextBlock Classes="summary-label" Text="SERVICES"/><TextBlock Classes="summary-value" Text="{Binding ServiceSummary}"/></StackPanel></Border>
                                <Border Classes="summary-card"><StackPanel><TextBlock Classes="summary-label" Text="PIDS"/><TextBlock Classes="summary-value" Text="{Binding PidSummary}"/></StackPanel></Border>
                                <Border Classes="summary-card"><StackPanel><TextBlock Classes="summary-label" Text="TABLE GROUPS"/><TextBlock Classes="summary-value" Text="{Binding TableSummary}"/></StackPanel></Border>
                                <Border Classes="summary-card"><StackPanel><TextBlock Classes="summary-label" Text="BITRATE"/><TextBlock Classes="summary-value-small" Text="{Binding BitrateSummary}"/></StackPanel></Border>
                                <Border Classes="summary-card"><StackPanel><TextBlock Classes="summary-label" Text="TR 101 290"/><TextBlock Classes="summary-value-small" Text="{Binding ErrorSummary}"/></StackPanel></Border>
                                <Border Classes="summary-card"><StackPanel><TextBlock Classes="summary-label" Text="LAST ERROR PACKET"/><TextBlock Classes="summary-value-small" Text="{Binding LastPacketSummary}"/></StackPanel></Border>
                            </UniformGrid>
                            <Border Classes="overview-hint">
                                <TextBlock Text="Use Services for program discovery, Tables to inspect decoded structures, Errors for TR 101 290 health, and Bitrate for stream trends."
                                           TextWrapping="Wrap"/>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </TabItem>
                <TabItem Header="Services">
                    <Grid ColumnDefinitions="360,5,*" MinHeight="0">
                        <Border Grid.Column="0" Classes="parser-tree-panel">
                            <controls:TableTreeControl x:Name="ServicesTree" Store="{Binding TreeStore}"
                                                       TreeRevision="{Binding TreeRevision}" SelectedNodeId="{Binding SelectedNodeId}"/>
                        </Border>
                        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#dee2e6"/>
                        <Border Grid.Column="2" Classes="parser-detail-panel">
                            <controls:DetailPanelControl SelectedNode="{Binding SelectedNode}"/>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Tables">
                    <Grid ColumnDefinitions="360,5,*" MinHeight="0">
                        <Border Grid.Column="0" Classes="parser-tree-panel">
                            <controls:TableTreeControl x:Name="TableTree" Store="{Binding TreeStore}"
                                                       TreeRevision="{Binding TreeRevision}" SelectedNodeId="{Binding SelectedNodeId}"/>
                        </Border>
                        <GridSplitter Grid.Column="1" ResizeDirection="Columns" Background="#dee2e6"/>
                        <Border Grid.Column="2" Classes="parser-detail-panel">
                            <controls:DetailPanelControl SelectedNode="{Binding SelectedNode}"/>
                        </Border>
                    </Grid>
                </TabItem>
                <TabItem Header="Errors">
                    <controls:Tr101290PanelControl Store="{Binding Tr101290Store}" DataRevision="{Binding Tr101290Revision}"/>
                </TabItem>
                <TabItem Header="Bitrate">
                    <Grid RowDefinitions="Auto,*" Margin="16" HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                        <Grid ColumnDefinitions="*,Auto" Margin="0,0,0,10">
                            <StackPanel><TextBlock Text="Bitrate analysis" FontSize="20" FontWeight="SemiBold"/><TextBlock Text="Stream and selected PID traces" Foreground="#6c757d"/></StackPanel>
                            <Button Grid.Column="1" Classes="toolbar-btn" Content="Chart settings…" Click="OnChartSettingsClick"/>
                        </Grid>
                        <Border Grid.Row="1" Classes="parser-chart-panel" MinHeight="300"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch">
                            <controls:BitrateChartControl Store="{Binding BitrateStore}" DataRevision="{Binding BitrateRevision}"
                                HorizontalAlignment="Stretch" VerticalAlignment="Stretch"
                                ChartConfigRevision="{Binding ChartConfigRevision}" FitRevision="{Binding ChartFitRevision}"/>
                        </Border>
                    </Grid>
                </TabItem>
            </TabControl>
        </Panel>
    </Grid>
</Window>
