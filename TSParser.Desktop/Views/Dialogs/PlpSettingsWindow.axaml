<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:TSParser.Desktop.ViewModels"
        x:Class="TSParser.Desktop.Views.Dialogs.PlpSettingsWindow"
        x:DataType="vm:PlpSettingsViewModel"
        Title="PLP (T2-MI) PIDs"
        Classes="dialog-window"
        Width="440"
        SizeToContent="Height">

    <StackPanel Margin="20" Spacing="4">
        <TextBlock Classes="dialog-title" Text="PLP (T2-MI) PIDs"/>
        <TextBlock Classes="dialog-hint"
                   Text="T2-MI PIDs carrying PLP streams. OK restarts the current session when a file or UDP source is already open. Comma-separated decimal or hex (e.g. 0x1000, 4096)."/>

        <TextBlock Classes="dialog-field-label" Text="T2-MI PIDs"/>
        <TextBox Classes="dialog-input"
                 PlaceholderText="0x1000"
                 Text="{Binding PlpPidsText}"/>

        <TextBlock Classes="dialog-error"
                   Text="{Binding ErrorMessage}"
                   IsVisible="{Binding ErrorMessage, Converter={x:Static StringConverters.IsNotNullOrEmpty}}"/>

        <StackPanel Orientation="Horizontal"
                    HorizontalAlignment="Right"
                    Spacing="8"
                    Margin="0,16,0,0">
            <Button Classes="dialog-btn dialog-btn-primary" Content="OK" Click="OnOkClick" IsDefault="True"/>
            <Button Classes="dialog-btn" Content="Cancel" Click="OnCancelClick" IsCancel="True"/>
        </StackPanel>
    </StackPanel>
</Window>
