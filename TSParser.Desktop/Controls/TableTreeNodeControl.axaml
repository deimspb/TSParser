<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TSParser.Desktop.Controls"
             xmlns:models="using:TSParser.Desktop.Models"
             x:Class="TSParser.Desktop.Controls.TableTreeNodeControl"
             x:DataType="models:TableTreeNode"
             Node="{Binding}">
    <StackPanel Spacing="0">
        <Grid ColumnDefinitions="20,*" MinHeight="22" Margin="0,1">
            <Button x:Name="ToggleButton"
                    Grid.Column="0"
                    Classes="table-tree-toggle"
                    Click="OnToggleClick"
                    Padding="0"
                    MinWidth="20"
                    MinHeight="20"
                    HorizontalAlignment="Center"
                    VerticalAlignment="Center"
                    Background="Transparent"
                    BorderThickness="0"
                    FontSize="9"
                    Cursor="Hand"/>
            <Border x:Name="ToggleSpacer"
                    Grid.Column="0"
                    Width="20"/>

            <Button x:Name="LabelButton"
                    Grid.Column="1"
                    Click="OnSelectClick"
                    HorizontalAlignment="Stretch"
                    HorizontalContentAlignment="Left"
                    Padding="4,2"
                    Background="Transparent"
                    BorderThickness="0"
                    FontFamily="Consolas,Cascadia Mono,monospace"
                    FontSize="12"
                    Cursor="Hand"/>
        </Grid>

        <ItemsControl x:Name="ChildrenPanel"
                      ItemsSource="{Binding Children}"
                      Margin="16,0,0,0">
            <ItemsControl.ItemTemplate>
                <DataTemplate DataType="models:TableTreeNode">
                    <controls:TableTreeNodeControl Node="{Binding}"/>
                </DataTemplate>
            </ItemsControl.ItemTemplate>
        </ItemsControl>
    </StackPanel>
</UserControl>
