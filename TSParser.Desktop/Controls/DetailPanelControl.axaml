<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:controls="using:TSParser.Desktop.Controls"
             xmlns:models="using:TSParser.Desktop.Models"
             x:Class="TSParser.Desktop.Controls.DetailPanelControl"
             x:Name="Self">
    <UserControl.Styles>
        <Style Selector="ToggleButton.detail-view-btn">
            <Setter Property="Padding" Value="6,4"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="MinWidth" Value="48"/>
            <Setter Property="BorderThickness" Value="0"/>
            <Setter Property="Background" Value="#f8f9fa"/>
            <Setter Property="Foreground" Value="#495057"/>
        </Style>
        <Style Selector="ToggleButton.detail-view-btn:checked">
            <Setter Property="Background" Value="#0d6efd"/>
            <Setter Property="Foreground" Value="White"/>
        </Style>
        <Style Selector="TextBlock.detail-panel-content">
            <Setter Property="FontFamily" Value="Consolas,Cascadia Mono,monospace"/>
            <Setter Property="FontSize" Value="12"/>
            <Setter Property="TextWrapping" Value="Wrap"/>
            <Setter Property="Foreground" Value="#212529"/>
            <Setter Property="Background" Value="White"/>
        </Style>
        <Style Selector="Border.detail-panel-content-border">
            <Setter Property="Background" Value="White"/>
            <Setter Property="BorderBrush" Value="#e9ecef"/>
            <Setter Property="BorderThickness" Value="1"/>
            <Setter Property="CornerRadius" Value="4"/>
            <Setter Property="Padding" Value="8"/>
        </Style>
    </UserControl.Styles>

    <Grid RowDefinitions="Auto,*">
        <Grid Grid.Row="0" ColumnDefinitions="*,Auto" Margin="0,0,0,8">
            <TextBlock x:Name="TitleText"
                       Grid.Column="0"
                       FontWeight="SemiBold"
                       FontSize="14"
                       TextTrimming="CharacterEllipsis"
                       VerticalAlignment="Center"/>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="0">
                <ToggleButton x:Name="StringModeButton"
                              Classes="detail-view-btn"
                              Content="Details"
                              Click="OnStringModeClick"/>
                <ToggleButton x:Name="HexModeButton"
                              Classes="detail-view-btn"
                              Content="Raw hex"
                              Click="OnHexModeClick"/>
            </StackPanel>
        </Grid>

        <Panel Grid.Row="1">
            <TextBlock x:Name="PlaceholderText"
                       Text="Select a table or descriptor in the tree."
                       Foreground="#868e96"
                       FontSize="13"/>
            <Border x:Name="ContentBorder"
                    Classes="detail-panel-content-border"
                    IsVisible="False"
                    Padding="0">
                <Panel>
                    <controls:HexDumpControl x:Name="HexView"
                                             IsVisible="False"/>
                    <ScrollViewer x:Name="StringScroll"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled"
                                  IsVisible="False">
                        <TextBlock x:Name="ContentText"
                                   Classes="detail-panel-content"
                                   Margin="8"/>
                    </ScrollViewer>
                </Panel>
            </Border>
        </Panel>
    </Grid>
</UserControl>
