<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:sp="using:ScottPlot.Avalonia"
             x:Class="TSParser.Desktop.Controls.BitrateChartControl">

    <Grid RowDefinitions="Auto,*,Auto"
          Classes="bitrate-chart-panel">
        <Grid Grid.Row="0"
              ColumnDefinitions="*,Auto"
              Margin="0,0,0,4">
            <TextBlock x:Name="ChartTitle"
                       Grid.Column="0"
                       Classes="bitrate-chart-title"
                       Text="Bitrate"/>
            <TextBlock x:Name="ChartStats"
                       Grid.Column="1"
                       Classes="bitrate-chart-stats"
                       Text=""/>
        </Grid>

        <Grid x:Name="PlotHost"
              Grid.Row="1"
              MinHeight="120"
              ClipToBounds="True">
            <sp:AvaPlot x:Name="ChartPlot"
                        IsVisible="False"
                        ClipToBounds="True"
                        HorizontalAlignment="Stretch"
                        VerticalAlignment="Stretch"/>
            <Border x:Name="ProbeOverlay"
                    IsVisible="False"
                    IsHitTestVisible="False"
                    Classes="bitrate-chart-probe"
                    HorizontalAlignment="Left"
                    VerticalAlignment="Top"
                    Margin="8,8,0,0"
                    Padding="6,4"
                    CornerRadius="4">
                <TextBlock x:Name="ProbeText"
                           FontSize="11"
                           TextWrapping="Wrap"/>
            </Border>
            <TextBlock x:Name="PlaceholderText"
                       Classes="bitrate-chart-placeholder"
                       Text="Open Bitrate… to choose stream and/or PID traces, then parse a file or UDP stream."
                       TextWrapping="Wrap"
                       VerticalAlignment="Center"
                       HorizontalAlignment="Center"/>
        </Grid>

        <WrapPanel x:Name="LegendHost"
                   Grid.Row="2"
                   Classes="bitrate-chart-legend"
                   IsVisible="False"
                   HorizontalAlignment="Center"
                   Margin="0,4,0,0"/>
    </Grid>
</UserControl>
