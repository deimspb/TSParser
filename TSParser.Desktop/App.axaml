<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             x:Class="TSParser.Desktop.App"
             xmlns:local="using:TSParser.Desktop"
             RequestedThemeVariant="Light">
             <!-- Light: shell panels use explicit light colors; Default/Dark made Fluent scrollbars and controls mismatch. -->

    <Application.DataTemplates>
        <local:ViewLocator/>
    </Application.DataTemplates>
  
    <Application.Styles>
        <FluentTheme />
        <StyleInclude Source="avares://TSParser.Desktop/Styles/ParserShellStyles.axaml"/>
        <StyleInclude Source="avares://TSParser.Desktop/Styles/DialogStyles.axaml"/>
    </Application.Styles>
</Application>