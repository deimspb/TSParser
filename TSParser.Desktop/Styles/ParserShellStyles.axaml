<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style Selector="Border.parser-toolbar">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#dee2e6"/>
        <Setter Property="BorderThickness" Value="0,0,0,1"/>
        <Setter Property="Padding" Value="8,6"/>
    </Style>

    <Style Selector="TextBlock.parser-brand">
        <Setter Property="FontWeight" Value="Bold"/>
        <Setter Property="FontSize" Value="15"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Button.toolbar-btn">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="Padding" Value="6,4"/>
        <Setter Property="Margin" Value="0,0,4,0"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderBrush" Value="#ced4da"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Background" Value="#f8f9fa"/>
        <Setter Property="Foreground" Value="#212529"/>
    </Style>

    <Style Selector="Button.toolbar-btn:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#e9ecef"/>
    </Style>

    <Style Selector="Button.toolbar-btn:disabled">
        <Setter Property="Opacity" Value="0.55"/>
    </Style>

    <Style Selector="Button.toolbar-btn-primary">
        <Setter Property="Background" Value="#0d6efd"/>
        <Setter Property="BorderBrush" Value="#0d6efd"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>

    <Style Selector="Button.toolbar-btn-primary:pointerover /template/ ContentPresenter">
        <Setter Property="Background" Value="#0b5ed7"/>
    </Style>

    <Style Selector="TextBox.toolbar-input-endpoint">
        <Setter Property="Width" Value="168"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="CornerRadius" Value="4"/>
        <Setter Property="BorderBrush" Value="#ced4da"/>
    </Style>

    <Style Selector="ComboBox.toolbar-select">
        <Setter Property="MinWidth" Value="140"/>
        <Setter Property="MaxWidth" Value="220"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="MinHeight" Value="28"/>
        <Setter Property="CornerRadius" Value="4"/>
    </Style>

    <Style Selector="TextBlock.toolbar-label">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#6c757d"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="Margin" Value="8,0,4,0"/>
    </Style>

    <Style Selector="TextBlock.parser-status">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="Foreground" Value="#495057"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
        <Setter Property="HorizontalAlignment" Value="Right"/>
        <Setter Property="MaxWidth" Value="320"/>
    </Style>

    <Style Selector="TextBlock.parser-status-error">
        <Setter Property="Foreground" Value="#b02a37"/>
    </Style>

    <Style Selector="TextBlock.tr-cell.error">
        <Setter Property="Foreground" Value="#b02a37"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>

    <Style Selector="Border.parser-chart-panel">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#dee2e6"/>
        <Setter Property="BorderThickness" Value="0,1,0,0"/>
        <Setter Property="Padding" Value="8,6,10,8"/>
    </Style>

    <Style Selector="Grid.bitrate-chart-panel">
        <Setter Property="MinHeight" Value="0"/>
    </Style>

    <Style Selector="TextBlock.bitrate-chart-title">
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="13"/>
    </Style>

    <Style Selector="TextBlock.bitrate-chart-stats">
        <Setter Property="Foreground" Value="#495057"/>
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="TextBlock.bitrate-chart-placeholder">
        <Setter Property="Foreground" Value="#868e96"/>
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.bitrate-chart-probe">
        <Setter Property="Background" Value="#f8f9facc"/>
        <Setter Property="BorderBrush" Value="#ced4da"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="MaxWidth" Value="280"/>
    </Style>

    <Style Selector="Border.bitrate-chart-probe TextBlock">
        <Setter Property="Foreground" Value="#212529"/>
        <Setter Property="FontFamily" Value="Consolas,Courier New,monospace"/>
    </Style>

    <Style Selector="WrapPanel.bitrate-chart-legend">
        <Setter Property="MaxHeight" Value="48"/>
    </Style>

    <Style Selector="WrapPanel.bitrate-chart-legend TextBlock">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#495057"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="Border.parser-tree-panel">
        <Setter Property="Background" Value="#f8f9fa"/>
        <Setter Property="BorderBrush" Value="#dee2e6"/>
        <Setter Property="BorderThickness" Value="0,0,1,0"/>
        <Setter Property="Padding" Value="12,8,8,8"/>
    </Style>

    <Style Selector="Border.parser-detail-panel">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Padding" Value="12,12,16,12"/>
    </Style>

    <!-- Light shell scrollbars (tree, hex, string, dialogs) -->
    <Style Selector="ScrollBar">
        <Setter Property="Background" Value="#f1f3f5"/>
    </Style>
    <Style Selector="ScrollBar /template/ Thumb">
        <Setter Property="Background" Value="#ced4da"/>
        <Setter Property="BorderBrush" Value="#adb5bd"/>
        <Setter Property="BorderThickness" Value="0"/>
    </Style>
    <Style Selector="ScrollBar:pointerover /template/ Thumb">
        <Setter Property="Background" Value="#adb5bd"/>
    </Style>
    <Style Selector="ScrollBar:pressed /template/ Thumb">
        <Setter Property="Background" Value="#868e96"/>
    </Style>
    <Style Selector="Border.tr-panel">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Padding" Value="8,6,8,4"/>
    </Style>

    <Style Selector="TextBlock.tr-summary">
        <Setter Property="FontSize" Value="13"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="VerticalAlignment" Value="Center"/>
    </Style>

    <Style Selector="TextBlock.tr-header">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#6c757d"/>
    </Style>

    <Style Selector="TextBlock.tr-cell">
        <Setter Property="FontSize" Value="12"/>
        <Setter Property="TextTrimming" Value="CharacterEllipsis"/>
    </Style>

    <Style Selector="ListBox.tr-list">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderThickness" Value="0"/>
        <Setter Property="FontSize" Value="12"/>
    </Style>

    <Style Selector="Button.launch-btn, Button.launch-btn-primary">
        <Setter Property="Padding" Value="18,10"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="BorderBrush" Value="#ced4da"/>
        <Setter Property="Background" Value="White"/>
    </Style>
    <Style Selector="Button.launch-btn-primary">
        <Setter Property="Background" Value="#0d6efd"/>
        <Setter Property="BorderBrush" Value="#0d6efd"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style Selector="Border.summary-card">
        <Setter Property="Background" Value="White"/>
        <Setter Property="BorderBrush" Value="#e2e8f0"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="18"/>
        <Setter Property="Margin" Value="5"/>
        <Setter Property="MinHeight" Value="105"/>
    </Style>
    <Style Selector="TextBlock.summary-label">
        <Setter Property="FontSize" Value="11"/>
        <Setter Property="Foreground" Value="#6c757d"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style Selector="TextBlock.summary-value">
        <Setter Property="FontSize" Value="28"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,5,0,0"/>
    </Style>
    <Style Selector="TextBlock.summary-value-small">
        <Setter Property="FontSize" Value="18"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Margin" Value="0,9,0,0"/>
    </Style>
    <Style Selector="Border.overview-hint">
        <Setter Property="Background" Value="#eef5ff"/>
        <Setter Property="BorderBrush" Value="#cfe2ff"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="8"/>
        <Setter Property="Padding" Value="16"/>
    </Style>
    <Style Selector="Border.tr-priority-card">
        <Setter Property="Background" Value="#f8f9fa"/>
        <Setter Property="BorderBrush" Value="#dee2e6"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="CornerRadius" Value="6"/>
        <Setter Property="Padding" Value="12"/>
        <Setter Property="Margin" Value="4"/>
    </Style>
    <Style Selector="Border.tr-priority-card.p1"><Setter Property="BorderBrush" Value="#dc3545"/></Style>
    <Style Selector="Border.tr-priority-card.p2"><Setter Property="BorderBrush" Value="#fd7e14"/></Style>
    <Style Selector="Border.tr-priority-card.p3"><Setter Property="BorderBrush" Value="#ffc107"/></Style>
</Styles>

