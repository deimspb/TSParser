@using TSParser.Web.Services
@inject IJSRuntime Js

<div class="hex-dump">
    <div class="hex-dump-viewport">
        <div class="hex-dump-layout">
            <div class="hex-dump-header">
                <div class="hex-dump-corner"></div>
                <div class="hex-dump-cols">
                    @foreach (var header in HexDumpFormatter.ColumnHeaders)
                    {
                        <span class="hex-dump-col">@header</span>
                    }
                </div>
            </div>
            <div class="hex-dump-body">
                <div class="hex-dump-offsets">
                    @foreach (var line in _lines)
                    {
                        <div class="hex-dump-offset-line">@line.Offset</div>
                    }
                </div>
                <pre class="hex-dump-data-text"
                     spellcheck="false"
                     @onkeydown="OnDataKeyDown">@_displayText</pre>
            </div>
        </div>
    </div>
</div>

@code {
    private IReadOnlyList<(string Offset, string[] Cells)> _lines = [];
    private string _displayText = "";
    private string _copyText = "";

    [Parameter, EditorRequired]
    public byte[] Bytes { get; set; } = [];

    protected override void OnParametersSet()
    {
        _lines = HexDumpFormatter.BuildLines(Bytes);
        _displayText = HexDumpFormatter.BuildDisplayText(Bytes);
        _copyText = HexDumpFormatter.GetCopyText(Bytes);
    }

    private async Task OnDataKeyDown(KeyboardEventArgs e)
    {
        if (!e.CtrlKey || !string.Equals(e.Key, "c", StringComparison.OrdinalIgnoreCase))
            return;

        var selected = await Js.InvokeAsync<string>("eval", "window.getSelection()?.toString() ?? ''");
        if (!string.IsNullOrWhiteSpace(selected))
            return;

        await Js.InvokeVoidAsync("navigator.clipboard.writeText", _copyText);
    }
}
